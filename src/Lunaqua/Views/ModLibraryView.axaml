<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lunaqua.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Lunaqua.Views.ModLibraryView"
             x:DataType="vm:ModLibraryViewModel">

  <Grid ColumnDefinitions="400,*">
    <!-- 左：搜索 + 列表 -->
    <Border Grid.Column="0"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource CardBorderBrush}">
      <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Classes="pageTitle" Text="{Binding Title}" Margin="0,0,0,12" />

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Text="{Binding SearchText}"
                   PlaceholderText="搜索名字 / 作者 / id" />
          <Button Grid.Column="1"
                  Command="{Binding RefreshCommand}"
                  ToolTip.Tip="重新读取站点目录">
            <ic:FluentIcon Icon="ArrowSync" IconSize="Size16" />
          </Button>
        </Grid>

        <TextBlock DockPanel.Dock="Top"
                   Classes="hint"
                   Text="{Binding StatusText}"
                   Margin="0,10,0,6" />

        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding HasError}"
                Background="{DynamicResource CodeBackgroundBrush}"
                CornerRadius="6"
                Padding="10,8"
                Margin="0,8,0,0">
          <ScrollViewer MaxHeight="120">
            <TextBlock Text="{Binding ErrorText}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource WarningBrush}" />
          </ScrollViewer>
        </Border>

        <ListBox ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ModListItemViewModel">
              <StackPanel Spacing="2" Margin="0,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <Border IsVisible="{Binding HasWarning}"
                          Background="{DynamicResource NavActiveBrush}"
                          CornerRadius="4"
                          Padding="5,0"
                          VerticalAlignment="Center">
                    <TextBlock Text="!" FontSize="11" FontWeight="Bold" />
                  </Border>
                </StackPanel>
                <TextBlock Classes="hint" Text="{Binding Subtitle}" />
                <TextBlock Classes="hint"
                           Text="{Binding WarningText}"
                           Foreground="{DynamicResource WarningBrush}"
                           IsVisible="{Binding HasWarning}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- 右：详情 -->
    <ContentControl Grid.Column="1" Content="{Binding Detail}" />
  </Grid>
</UserControl>
