<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lunaqua.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Lunaqua.Views.ModDetailView"
             x:DataType="vm:ModDetailViewModel">

  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top"
               Classes="hint"
               Text="{Binding EmptyHint}"
               IsVisible="{Binding !HasSelection}" />

    <StackPanel IsVisible="{Binding HasSelection}" Spacing="12">
      <!-- 标题 + 状态 + 动作 -->
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Classes="hint" Text="{Binding MetaText}" />
        <TextBlock Text="{Binding StatusText}" FontSize="13" />
      </StackPanel>

      <WrapPanel>
        <Button Command="{Binding InstallLatestCommand}" Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="ArrowDownload" IconSize="Size16" />
            <TextBlock Text="{Binding InstallButtonText}" />
          </StackPanel>
        </Button>

        <Button Command="{Binding ToggleEnabledCommand}"
                IsVisible="{Binding CanToggleEnabled}"
                Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="ArrowSync" IconSize="Size16" />
            <TextBlock Text="{Binding ToggleEnabledText}" />
          </StackPanel>
        </Button>

        <Button Command="{Binding UninstallCommand}"
                IsVisible="{Binding CanToggleEnabled}"
                Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ic:FluentIcon Icon="Delete" IconSize="Size16" />
            <TextBlock Text="卸载" />
          </StackPanel>
        </Button>

        <Button Command="{Binding IgnoreUpdateCommand}"
                IsVisible="{Binding CanIgnoreUpdate}"
                Margin="0,0,8,8"
                ToolTip.Tip="不再提示这个版本">
          <TextBlock Text="忽略此版本" />
        </Button>
      </WrapPanel>

      <TextBlock Classes="hint"
                 Text="{Binding ActionStatus}"
                 IsVisible="{Binding ActionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Border IsVisible="{Binding HasWarning}"
              Background="{DynamicResource CodeBackgroundBrush}"
              CornerRadius="6"
              Padding="10,8">
        <TextBlock Text="{Binding WarningText}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource WarningBrush}" />
      </Border>

      <TabControl>
        <!-- 概览 -->
        <TabItem Header="概览">
          <ScrollViewer>
            <StackPanel Spacing="12" Margin="12">
              <StackPanel Spacing="6">
                <TextBlock Classes="sectionTitle" Text="简介" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Classes="sectionTitle" Text="readme" />
                <Border Background="{DynamicResource CodeBackgroundBrush}" CornerRadius="6" Padding="12">
                  <TextBlock Text="{Binding ReadmeText}"
                             TextWrapping="Wrap"
                             FontFamily="Cascadia Mono, Consolas, monospace"
                             FontSize="12" />
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- 配置 -->
        <TabItem Header="配置">
          <DockPanel Margin="12">
            <TextBlock DockPanel.Dock="Top" Classes="hint" Text="{Binding Config.EffectHint}" />

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,10,0,6">
              <CheckBox Content="只看已改动项" IsChecked="{Binding Config.OnlyChanged}" />
              <Button Content="全部重置" Command="{Binding Config.ResetAllCommand}" />
              <Button Content="重新载入" Command="{Binding Config.ReloadCommand}" />
              <Button Content="启动游戏" Command="{Binding Config.LaunchGameCommand}"
                      IsVisible="{Binding Config.HasNoConfig}" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Classes="hint" Text="{Binding Config.StatusText}" Margin="0,0,0,8" />

            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Config.Entries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConfigEntryViewModel">
                    <Border Classes="card" Margin="0,0,0,8">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="hint" Text="{Binding Key}" />
                        <TextBlock Classes="hint" Text="{Binding RangeHint}" IsVisible="{Binding HasRange}" />

                        <ToggleSwitch IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                      IsVisible="{Binding IsBoolean}"
                                      IsEnabled="{Binding IsEditable}" />

                        <NumericUpDown Value="{Binding NumberValue, Mode=TwoWay}"
                                       Minimum="{Binding Minimum}"
                                       Maximum="{Binding Maximum}"
                                       ShowButtonSpinner="False"
                                       IsVisible="{Binding IsNumber}"
                                       IsEnabled="{Binding IsEditable}" />

                        <ComboBox ItemsSource="{Binding Options}"
                                  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                  IsVisible="{Binding IsEnum}"
                                  IsEnabled="{Binding IsEditable}" />

                        <TextBox Text="{Binding Text, Mode=TwoWay}"
                                 PlaceholderText="{Binding Placeholder}"
                                 IsVisible="{Binding IsText}"
                                 IsEnabled="{Binding IsEditable}"
                                 LostFocus="OnEntryTextLostFocus"
                                 KeyDown="OnEntryKeyDown" />

                        <TextBlock Text="{Binding ErrorText}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   IsVisible="{Binding HasError}" />

                        <Button Content="重置"
                                Command="{Binding ResetCommand}"
                                IsEnabled="{Binding IsEditable}"
                                HorizontalAlignment="Left" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <!-- 版本 -->
        <TabItem Header="版本">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Versions}" Margin="12">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ModVersionViewModel">
                  <Border Classes="card" Margin="0,0,0,8">
                    <DockPanel>
                      <Button DockPanel.Dock="Right"
                              Command="{Binding $parent[ItemsControl].((vm:ModDetailViewModel)DataContext).InstallVersionCommand}"
                              CommandParameter="{Binding}"
                              VerticalAlignment="Top"
                              ToolTip.Tip="安装这个版本">
                        <TextBlock Text="装这个" />
                      </Button>

                      <StackPanel Spacing="6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                          <Border IsVisible="{Binding HasBadge}"
                                  Background="{DynamicResource NavActiveBrush}"
                                  CornerRadius="4"
                                  Padding="6,0"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding BadgeText}" FontSize="11" />
                          </Border>
                          <TextBlock Classes="hint" Text="{Binding ReleasedText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="hint" Text="{Binding FileSummary}" />
                        <TextBlock Text="{Binding ChangelogText}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasChangelog}" />
                        <TextBlock Classes="hint" Text="{Binding FileListText}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </StackPanel>
  </DockPanel>
</UserControl>
