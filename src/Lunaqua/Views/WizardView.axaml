<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lunaqua.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="Lunaqua.Views.WizardView"
             x:DataType="vm:WizardViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Classes="pageTitle" Text="{Binding Title}" />
      <TextBlock Classes="hint" Text="{Binding Hint}" />

      <!-- 第 1 步 -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="① 找到游戏" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Background="{DynamicResource NavActiveBrush}" CornerRadius="4" Padding="6,0">
              <TextBlock Text="{Binding Step1Badge}" FontSize="11" />
            </Border>
          </StackPanel>

          <TextBlock Text="{Binding GameDirectoryText}" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding LocateCommand}" IsEnabled="{Binding !IsBusy}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:FluentIcon Icon="Search" IconSize="Size16" />
                <TextBlock Text="自动找游戏" />
              </StackPanel>
            </Button>
            <Button Content="手动选择目录…" Command="{Binding PickDirectoryCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="打开游戏目录" Command="{Binding OpenGameDirectoryCommand}" />
            <Button Content="Steam 校验文件" Command="{Binding OpenSteamValidateCommand}"
                    ToolTip.Tip="打开 steam://validate/674940" />
          </StackPanel>

          <TextBlock Text="{Binding LocateStatus}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

          <Button Content="信任这些文件并继续"
                  Command="{Binding TrustCommand}"
                  IsVisible="{Binding NeedsTrust}"
                  HorizontalAlignment="Left"
                  ToolTip.Tip="把这个版本的文件哈希记成本机基线，以后不再提示" />
        </StackPanel>
      </Border>

      <!-- 第 2 步 -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="② 自动安装" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Background="{DynamicResource NavActiveBrush}" CornerRadius="4" Padding="6,0">
              <TextBlock Text="{Binding Step2Badge}" FontSize="11" />
            </Border>
          </StackPanel>

          <TextBlock Classes="hint" Text="备份现有文件 → 部署 BepInEx 5.4.23.5（23 个文件逐哈希校验）→ 失败自动还原。" />

          <Button Command="{Binding DeployCommand}"
                  IsEnabled="{Binding CanDeploy}"
                  HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ic:FluentIcon Icon="Wrench" IconSize="Size16" />
              <TextBlock Text="{Binding DeployButtonText}" />
            </StackPanel>
          </Button>

          <TextBlock Text="{Binding DeployStatus}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
        </StackPanel>
      </Border>

      <!-- 第 3 步 -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="③ 验证" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Background="{DynamicResource NavActiveBrush}" CornerRadius="4" Padding="6,0">
              <TextBlock Text="{Binding Step3Badge}" FontSize="11" />
            </Border>
          </StackPanel>

          <TextBlock Text="{Binding VerifyStatus}"
                     TextWrapping="Wrap"
                     FontSize="12"
                     Opacity="0.8"
                     MaxHeight="220" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
